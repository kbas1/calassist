# TEMPLATE ONLY - contains no real values.
# Copy to ~/.config/calassist/env (NOT into this repo):
#     cp .env.example ~/.config/calassist/env
#     chmod 600 ~/.config/calassist/env

ANTHROPIC_API_KEY=PUT-YOUR-KEY-HERE

# Google Calendar > calendar settings > Integrate calendar > Calendar ID
CALASSIST_CALENDAR_ID=

# Weekly priorities as a plain local file. Deliberately NOT Google Docs —
# the Docs API has no per-document scope, so reading one doc would grant
# read access to every document in the account.
PRIORITIES_FILE=~/Documents/calassist-priorities.md
